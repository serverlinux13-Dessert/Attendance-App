{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "app.py": {
      "maxDuration": 60,
      "includeFiles": [
        "public/**",
        "templates/**",
        "static/**"
      ],
      "excludeFiles": [
        ".venv/**",
        ".dist/**",
        "db_backup/**",
        "deploy/**",
        "__pycache__/**",
        ".git/**",
        "*.db",
        "database.db"
      ]
    }
  }
}
